#!/usr/bin/env bash

# Quietly poll yay for updates and reliably pipe to wc.
# Note: we disable pipefail/set -e here since yay can return a non-zero 
# exit code if there are simply no updates or network is down.
repo_count=$(yay -Qu --repo 2>/dev/null | wc -l)
aur_count=$(yay -Qua 2>/dev/null | wc -l)
update_count=$((repo_count + aur_count))

printf '{"repo":%d,"aur":%d,"total":%d}\n' "$repo_count" "$aur_count" "$update_count"
